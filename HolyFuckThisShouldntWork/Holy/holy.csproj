<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>holy</AssemblyName>
    <RootNamespace>HolyHolyHoly</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>1701;1702;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="MMHOOK.RoR2" Version="2026.10.8" NoWarn="NU1701" />
    <PackageReference Include="R2API.RecalculateStats" Version="1.7.0" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.45" />
  </ItemGroup>

  <PropertyGroup>
    <ProfileName Condition="'$(ProfileName)' == ''">Current</ProfileName>
    <ProfileDeployDir>$(APPDATA)\r2modmanPlus-local\RiskOfRain2\profiles\$(ProfileName)\BepInEx\plugins\yekoc-HolyHolyHOLY</ProfileDeployDir>
  </PropertyGroup>

  <Target Name="DeployToProfile" AfterTargets="Build" Condition="Exists('$(ProfileDeployDir)')">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ProfileDeployDir)" Retries="0" ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="Deployed $(TargetName) to $(ProfileDeployDir)" />
  </Target>

</Project>
